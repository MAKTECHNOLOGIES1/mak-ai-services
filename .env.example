# =========================================================================
# AMK Technologies - Environment Configuration Variables (.env)
# Copy this file to .env and replace with your local credentials
# =========================================================================

# Database Configuration (Supabase PostgreSQL Cloud)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_db_password
DB_SSL_MODE=require
DB_SCHEMA=identity_service

# Full Connection URL for Async SQLAlchemy (FastAPI Services)
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require

# Direct Connection URL
DIRECT_DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Provider API Keys (Keep Strictly Server-Side)
AI_PROVIDER=gemini # 'gemini' or 'openai'
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere

# Global Quota Defaults
STUDENT_DAILY_QUERY_LIMIT=25
FACULTY_DAILY_QUERY_LIMIT=100

# Cloudflare R2 Object Storage (For Syllabus & Project PDFs)
S3_ENDPOINT=https://a8783999a53c63b47959dbf8b88fca11.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_BUCKET_NAME=mak-services-builds

# Server Port
SERVER_PORT=8080

