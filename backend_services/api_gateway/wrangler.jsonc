{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mak-api-gateway",
  "main": "main.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "APP_NAME": "AMK API GATEWAY",
    "SERVICE_NAME": "api_gateway",
    "ENVIRONMENT": "development"
  },
  "env": {
    "test": {
      "name": "mak-api-gateway-test",
      "vars": {
        "APP_NAME": "AMK API GATEWAY",
        "SERVICE_NAME": "api_gateway",
        "ENVIRONMENT": "test"
      }
    },
    "prod": {
      "name": "mak-api-gateway",
      "vars": {
        "APP_NAME": "AMK API GATEWAY",
        "SERVICE_NAME": "api_gateway",
        "ENVIRONMENT": "production"
      }
    }
  }
}
