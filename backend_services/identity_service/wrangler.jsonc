{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mak-identity-service",
  "main": "main.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "python_workers",
    "python_shared_standard_library"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": false
    }
  },
  "env": {
    "test": {
      "name": "mak-identity-service-test",
      "workers_dev": true,
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "redact_query_string": false,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        },
        "issues": {
          "enabled": false
        }
      }
    },
    "prod": {
      "name": "mak-identity-service",
      "workers_dev": true,
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "redact_query_string": false,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        },
        "issues": {
          "enabled": false
        }
      }
    }
  }
}
