{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mak-identity-service",
  "main": "main.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "python_workers",
    "python_shared_standard_library"
  ],
  "workers_dev": true,
  "vars": {
    "APP_NAME": "AMK Identity Service",
    "SERVICE_NAME": "identity_service",
    "DB_SCHEMA": "identity_service",
    "ENVIRONMENT": "development"
  },
  "env": {
    "test": {
      "name": "mak-identity-service-test",
      "workers_dev": true,
      "vars": {
        "APP_NAME": "AMK Identity Service",
        "SERVICE_NAME": "identity_service",
        "DB_SCHEMA": "identity_service",
        "ENVIRONMENT": "test"
      }
    },
    "prod": {
      "name": "mak-identity-service",
      "workers_dev": true,
      "vars": {
        "APP_NAME": "AMK Identity Service",
        "SERVICE_NAME": "identity_service",
        "DB_SCHEMA": "identity_service",
        "ENVIRONMENT": "production"
      }
    }
  }
}
