{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mak-tenant-service",
  "main": "main.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "python_workers"
  ],
  "rules": [
    {
      "type": "PythonModule",
      "globs": [
        "*.py",
        "core/**/*.py",
        "models/**/*.py",
        "routes/**/*.py",
        "schemas/**/*.py",
        "services/**/*.py"
      ],
      "fallthrough": false
    }
  ],
  "vars": {
    "APP_NAME": "AMK Tenant Service",
    "SERVICE_NAME": "tenant_service",
    "DB_SCHEMA": "identity_service",
    "ENVIRONMENT": "development"
  },
  "env": {
    "test": {
      "name": "mak-tenant-service-test",
      "vars": {
        "APP_NAME": "AMK Tenant Service",
        "SERVICE_NAME": "tenant_service",
        "DB_SCHEMA": "identity_service",
        "ENVIRONMENT": "test"
      }
    },
    "prod": {
      "name": "mak-tenant-service",
      "vars": {
        "APP_NAME": "AMK Tenant Service",
        "SERVICE_NAME": "tenant_service",
        "DB_SCHEMA": "identity_service",
        "ENVIRONMENT": "production"
      }
    }
  }
}
